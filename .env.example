# ── 基础（本地可直接用默认；生产务必改强值）────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 本地可不填：后端会用开发默认密钥；生产必须 ≥16 位随机串
JWT_SECRET=aivideo-local-jwt-secret-do-not-use-in-prod
SETTINGS_SECRET=aivideo-local-settings-secret-do-not-use-in-prod

# 未设置时：非 production 默认 true，production 默认 false
TYPEORM_SYNCHRONIZE=true

# ── 网络 ─────────────────────────────────────────────────
FRONTEND_PORT=9088
# PORT=47822
DATA_DIR=./data
# Cookie 是否加 Secure。默认按请求是否 HTTPS 自动判断；HTTP 部署勿强制 true
# COOKIE_SECURE=false
# 未设置时：本地反射 Origin；生产仅同站。也可写 * 或白名单
# CORS_ORIGIN=http://localhost:5177,http://localhost:9088

# Docker Hub 发布/拉取（见 scripts/docker-publish.* 与 docker-compose.hub.yml）
DOCKERHUB_USER=
IMAGE_TAG=latest

# 任务并发在「设置 → 任务与存储 → 任务并发」配置，无需环境变量
# Docker 镜像已内置 Redis，默认 REDIS_URL=redis://127.0.0.1:6379（BullMQ）
# 本地开发可不配（进程内队列）；外置 Redis 时覆盖为非本机地址即可
# REDIS_URL=redis://127.0.0.1:6379

# 单容器默认本地磁盘存储；配置 MinIO 时改为 minio 并填写下方 FILE_OSS_*
STORAGE_MODE=local

# ── 对象存储（MinIO / S3，无内置地址）──────────────────────
# 优先在「设置 → 任务与存储」配置；以下仅作首次启动导入
# FILE_OSS_BASE_URL=
# FILE_OSS_BUCKET=lumina
# FILE_OSS_ACCESS_KEY_ID=
# FILE_OSS_ACCESS_KEY_SECRET=
# FILE_OSS_KEY_PREFIX=ai/video-studio
# LEGACY_OSS_PUBLIC_PREFIX=
# LEGACY_OSS_HOSTS=

# ── AIGC 视频工厂 Hub（无内置 Token；地址可按需填）────────────────
# 不配则不同步；也可在设置页填写
# LUMINA_HUB_URL=
# LUMINA_HUB_TOKEN=
# LUMINA_HUB_CALLBACK_URL=http://本机IP:47822/api/hub/webhook
# LUMINA_HUB_WEBHOOK_SECRET=
# 本地可切换的开发 Hub（配置后设置页出现开关）
# LUMINA_HUB_DEV_URL=http://localhost:5174
# LUMINA_HUB_DEV_TOKEN=
