# ── 基础（本地可直接用默认；生产务必改强值）────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 本地可不填：后端会用开发默认密钥；生产必须 ≥16 位随机串
JWT_SECRET=aivideo-local-jwt-secret-do-not-use-in-prod
SETTINGS_SECRET=aivideo-local-settings-secret-do-not-use-in-prod

# 未设置时：非 production 默认 true，production 默认 false
TYPEORM_SYNCHRONIZE=true

# ── MySQL（外置，不打包）──────────────────────────────────
MYSQL_HOST=8.130.171.89
MYSQL_PORT=8096
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_DATABASE=ai-video-studio

# ── 网络 ─────────────────────────────────────────────────
FRONTEND_PORT=9088
# PORT=47822
DATA_DIR=./data
# Cookie 是否加 Secure。默认按请求是否 HTTPS 自动判断；HTTP 部署勿强制 true
# COOKIE_SECURE=false
# 未设置时：本地反射 Origin；生产仅同站。也可写 * 或白名单
# CORS_ORIGIN=http://localhost:5177,http://localhost:5178,http://localhost:9088

# Docker Hub 发布/拉取（见 docker-compose.hub.yml）
DOCKERHUB_USER=
IMAGE_TAG=latest

# 任务并发在「设置 → 任务与存储 → 任务并发」配置，无需环境变量
# Docker 镜像已内置 Redis，默认 REDIS_URL=redis://127.0.0.1:6379（BullMQ）
# 本地开发可不配（进程内队列）；外置 Redis 时覆盖为非本机地址即可
# REDIS_URL=redis://127.0.0.1:6379

# ── 对象存储（MinIO，密钥勿提交仓库；也可在后台「对象存储」填写）──
# FILE_OSS_BASE_URL=https://minio-aka.iepose.cn
# FILE_OSS_API_ENDPOINT=http://100.66.1.5:9000
# FILE_OSS_BUCKET=ai-video-studio
# FILE_OSS_KEY_PREFIX=media
# FILE_OSS_ACCESS_KEY_ID=
# FILE_OSS_ACCESS_KEY_SECRET=
# CMS 种子资源公网前缀（可选，默认同 FILE_OSS_BASE_URL）
# CMS_ASSET_BASE_URL=

# ── 渠道/模型/CMS：后台 /admin/ 配置；前台设置仅账号与任务并发 ──
