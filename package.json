{
  "name": "ai-video-studio",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build -w @ai-video-studio/shared",
    "build:backend": "npm run build:shared && npm run build -w ai-video-studio-backend",
    "build:frontend": "npm run build:shared && npm run build -w ai-video-studio-frontend",
    "build": "npm run build:shared && npm run build -w ai-video-studio-backend && npm run build -w ai-video-studio-frontend",
    "dev:backend": "npm run start:dev -w ai-video-studio-backend",
    "dev:frontend": "npm run dev -w ai-video-studio-frontend",
    "test": "npm run test -w @ai-video-studio/shared && npm run test -w ai-video-studio-backend",
    "test:shared": "npm run test -w @ai-video-studio/shared",
    "test:backend": "npm run test -w ai-video-studio-backend",
    "test:frontend": "npm run test -w ai-video-studio-frontend",
    "check:types": "npm run typecheck -w ai-video-studio-frontend",
    "minio": "docker compose up -d minio",
    "oss:upload-static": "node scripts/upload-static-to-minio.mjs",
    "oss:seed-library": "node scripts/seed-nami-library.mjs",
    "oss:import-library": "node scripts/import-nami-library-folder.mjs",
    "oss:download-modes": "node scripts/download-nami-modes.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
